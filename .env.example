# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Used by the backend when run locally (outside Docker). Inside Docker
# Compose, docker-compose.yml overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://job_intel:job_intel@localhost:5432/job_intelligence

# --- AI provider (server-side only - never exposed to the frontend) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_MAX_RETRIES=2

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
# Base URL the Next.js server/client use to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
